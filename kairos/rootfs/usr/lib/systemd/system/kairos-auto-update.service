[Unit]
Description=Install Kairos OS updates from GHCR
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/run/cos/recovery_mode
ConditionPathExists=!/run/cos/live_mode

[Service]
Type=oneshot
Environment=TMPDIR=/var/lib/kairos/tmp
ExecStartPre=/usr/bin/install -d -m 0755 /var/lib/kairos/tmp
ExecStart=/usr/bin/flock -n -E 0 /run/kairos-auto-update.lock /usr/bin/kairos-auto-update --upgrade
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
