#!/bin/sh
set -eu

# Exactly one of these exists on a typical Intel or AMD mini PC. Requiring a
# successful load keeps a node with disabled virtualization visibly unhealthy.
if ! modprobe kvm_intel 2>/dev/null; then
  modprobe kvm_amd
fi

modprobe vhost_vsock
modprobe vhost_net
modprobe tun
modprobe br_netfilter
