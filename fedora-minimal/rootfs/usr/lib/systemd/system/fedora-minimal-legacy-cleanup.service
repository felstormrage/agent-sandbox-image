[Unit]
Description=Remove legacy Fedora minimal host units from persistent /etc
After=local-fs.target
Before=multi-user.target brew-firstboot.service ssh-sync-firstboot.service

[Service]
Type=oneshot
ExecStart=/usr/bin/fedora-minimal-legacy-cleanup
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
