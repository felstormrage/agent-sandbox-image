# syntax=docker/dockerfile:1

# Fedora bootc sandbox host with a minimal sandbox tool set.
#
# This variant keeps the immutable bootc update path, serial console, fish,
# Homebrew, and SSH key sync. The standard fedora-bootc base already includes
# Podman, Skopeo, rpm-ostree, toolbox, and common server tooling; this image
# deliberately does not add the gVisor, Firecracker, or Kairos
# container-networking stack.
FROM quay.io/fedora/fedora-bootc:45

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG VERSION=0.1.0
ARG USERNAME=nithin

LABEL org.opencontainers.image.title="fedora-minimal-sandbox" \
      org.opencontainers.image.description="Fedora bootc sandbox host with fish, Homebrew, and SSH key sync" \
      org.opencontainers.image.version="${VERSION}"

# 1. Core system, CLI tools, fish, and Homebrew prerequisites.
# Developer tools (bat, ripgrep, fd-find, du-dust, eza, zoxide, btop, neovim)
# are installed via Homebrew on first boot instead of in this layer.
# hadolint ignore=DL3041
RUN set -eux; \
    dnf -y install \
        qemu-guest-agent firewalld audit fail2ban fail2ban-firewalld zram-generator-defaults \
        curl wget fish tmux sudo openssh-server \
        git gcc make patch unzip bzip2 which zlib-devel procps-ng file; \
    dnf clean all

# 2-11. Copy shared scripts and copy pre-built configuration, scripts, and systemd units.
# This reduces layer count, improves syntax highlighting, and makes git diffs cleaner.
COPY rootfs/ /
COPY fedora-minimal/rootfs/ /
RUN chmod 0755 /usr/bin/install-homebrew /usr/bin/install-ssh-sync /usr/bin/fedora-minimal-legacy-cleanup && \
    chmod 0440 /etc/sudoers.d/sudoers

# Substitute the USERNAME in configuration files.
RUN find /usr/lib/tmpfiles.d /usr/lib/systemd/system -type f -exec sed -i "s/\${USERNAME}/${USERNAME}/g" {} \;

# 11. Add bootc install configuration specifying filesystem defaults for image building.
RUN mkdir -p /usr/lib/bootc/install && \
    cat > /usr/lib/bootc/install/99-fedora-install.toml <<'EOF'
[install]
filesystem = [
    { mountpoint = "/", type = "xfs", size = "10 GiB" },
    { mountpoint = "/boot", type = "ext4", size = "1 GiB" },
]
EOF

# 12. Enable required services and timers, and disable kdump on small VMs.
RUN systemctl enable \
    fedora-minimal-legacy-cleanup.service \
    bootc-fetch-apply-updates.timer \
    qemu-guest-agent.service \
    sshd.service \
    serial-getty@ttyS0.service \
    brew-firstboot.service \
    ssh-sync-firstboot.service \
    firewalld.service \
    auditd.service \
    fail2ban.service && \
    (systemctl disable kdump.service 2>/dev/null || true)

# 13. Validate the bootc image layout and configuration.
RUN bootc container lint
